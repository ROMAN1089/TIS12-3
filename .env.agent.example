# =============================================================================
# AI Agent Service Configuration
# =============================================================================

# Agent role: decomposer | db_architect | coder | generic
AGENT_ROLE=decomposer

# Service port
PORT=8001

# Authentication token (must match orchestrator's SERVICE_TOKEN or agent-specific token)
AGENT_SECRET_TOKEN=change-me-to-secret-token

# =============================================================================
# Ollama Configuration
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Maximum self-correction retries for code generation
MAX_SELF_CORRECTION_RETRIES=3

# =============================================================================
# S3/MinIO Configuration (for artifact storage)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agent-artifacts
S3_REGION=us-east-1
