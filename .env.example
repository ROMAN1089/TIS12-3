# =============================================================================
# Orchestrator Configuration
# =============================================================================

# Required: Service authentication token
SERVICE_TOKEN=change-me-to-secret-token

# =============================================================================
# Temporal Configuration
# =============================================================================
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=multi-agent-orchestrator

# =============================================================================
# Agent Service URLs (New unified /generate endpoint)
# =============================================================================
DECOMPOSER_AGENT_URL=http://decomposer:8001
EXECUTOR_AGENT_URL=http://executor:8002
VALIDATOR_AGENT_URL=http://validator:8003

# Optional: Per-agent tokens (if not set, SERVICE_TOKEN is used)
# DECOMPOSER_TOKEN=decomposer-specific-token
# EXECUTOR_TOKEN=executor-specific-token
# VALIDATOR_TOKEN=validator-specific-token

# =============================================================================
# S3/MinIO Configuration (for artifact storage)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agent-artifacts
S3_REGION=us-east-1

# =============================================================================
# Timeouts and Retry Configuration
# =============================================================================
ACTIVITY_START_TO_CLOSE_TIMEOUT=300
HTTP_REQUEST_TIMEOUT=60

MAX_RETRY_ATTEMPTS=3
INITIAL_RETRY_INTERVAL=1
MAX_RETRY_INTERVAL=10
BACKOFF_COEFFICIENT=2.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
